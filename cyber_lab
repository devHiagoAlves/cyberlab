  ]);

  useEffect(() => {
    // Simulador de ataques entrando
    const interval = setInterval(() => {
      const types = ['HIGH', 'MEDIUM', 'CRITICAL'];
      const ips = ['45.33.22.1', '10.0.0.5', '192.168.0.2', '8.8.8.8'];
      const attacks = ['Tentativa de SQL Injection detectada', 'Scanner de porta Nmap detectado', 'Tráfego anômalo na porta 443', 'Upload de arquivo PHP malicioso'];
      
