// --- TERMINAL SIMULATOR ---
function TerminalInterface({ addScore }) {
  const [history, setHistory] = useState([
    { type: 'system', content: 'Iniciando Kernel Hacking OS v1.0.4...' },
    { type: 'system', content: 'Conexão segura estabelecida.' },
    { type: 'info', content: 'Digite "help" para ver a lista de comandos disponíveis.' },
  ]);
  const [input, setInput] = useState('');
  const endRef = useRef(null);

  useEffect(() => {
    endRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [history]);

  const handleCommand = async (e) => {
    e.preventDefault();
    if (!input.trim()) return;

    const cmd = input.trim();
    const args = cmd.split(' ');
    const baseCmd = args[0].toLowerCase();

    // Add user command to history
    setHistory(prev => [...prev, { type: 'input', content: `$ ${cmd}` }]);
    setInput('');

    // Command Logic
    let response = [];
    
    switch(baseCmd) {
      case 'help':
        response = [
          { type: 'info', content: 'Comandos disponíveis:' },
          { type: 'info', content: '  help       - Mostra esta mensagem' },
          { type: 'info', content: '  clear      - Limpa o terminal' },
          { type: 'info', content: '  scan       - Inicia varredura (ex: scan target.local)' },
          { type: 'info', content: '  exploit    - Executa payload (ex: exploit sqli)' },
          { type: 'info', content: '  mitigate   - Aplica patch (ex: mitigate xss)' },
          { type: 'info', content: '  ask_ai     - Pergunta ao assistente IA (ex: ask_ai como usar nmap?)' },
        ];
        break;
      case 'clear':
        setHistory([]);
        return;
      case 'scan':
        const target = args[1] || 'unknown';
        if (target === 'target.local') {
          response = [
            { type: 'system', content: `Iniciando Nmap 7.93 em ${target}...` },
            { type: 'info', content: 'Porta 80/tcp aberta (http - Apache 2.4.49)' },
            { type: 'info', content: 'Porta 3306/tcp aberta (mysql)' },
            { type: 'warning', content: '[!] Possível vulnerabilidade SQLi detectada no endpoint /login' },
          ];
          addScore(10);
        } else {
          response = [{ type: 'error', content: `Alvo '${target}' inalcançável. Tente 'target.local'.` }];
        }
        break;
      case 'exploit':
        if (args[1] === 'sqli') {
          response = [
            { type: 'warning', content: 'Injetando payload: \' OR 1=1 --' },
            { type: 'success', content: 'Bypass de autenticação bem-sucedido!' },
            { type: 'success', content: 'Acesso Administrativo Concedido. (+50 XP)' },
          ];
          addScore(50);
        } else {
          response = [{ type: 'error', content: 'Uso: exploit [vulnerabilidade]. Tente: exploit sqli' }];
        }
        break;
      case 'mitigate':
        if (args[1] === 'sqli') {
          response = [
            { type: 'system', content: 'Aplicando Prepared Statements no backend...' },
            { type: 'success', content: 'Vulnerabilidade SQL Injection corrigida! (+50 XP)' },
          ];
          addScore(50);
        } else {
          response = [{ type: 'error', content: 'Vulnerabilidade desconhecida para mitigação.' }];
        }
        break;
      case 'ask_ai':
        const question = args.slice(1).join(' ');
        if (!question) {
          response = [{ type: 'error', content: 'Forneça uma pergunta. Ex: ask_ai o que é SQLi?' }];
        } else {
          setHistory(prev => [...prev, { type: 'system', content: 'Analisando consulta com IA Nexus...' }]);
          const aiReply = await callGeminiAPI(question);
          setHistory(prev => [...prev, { type: 'ai', content: `Nexus: ${aiReply}` }]);
          return; // Early return since we updated state async
        }
        break;
      default:
        response = [{ type: 'error', content: `Comando não encontrado: ${baseCmd}. Digite 'help'.` }];
    }

    setHistory(prev => [...prev, ...response]);
  };

  return (
    <div className="h-full flex flex-col p-6 font-mono text-sm">
      <div className="flex-1 bg-black/80 border border-gray-800 rounded-t-xl p-4 overflow-y-auto shadow-2xl">
        {history.map((line, i) => (
          <div key={i} className={`mb-1.5 ${
            line.type === 'input' ? 'text-gray-300' :
            line.type === 'error' ? 'text-red-400' :
            line.type === 'success' ? 'text-green-400' :
            line.type === 'warning' ? 'text-yellow-400' :
            line.type === 'ai' ? 'text-purple-400 border-l-2 border-purple-500 pl-2 my-2' :
            'text-blue-400'
          }`}>
            {line.content}
          </div>
        ))}
        <div ref={endRef} />
      </div>
      <form onSubmit={handleCommand} className="bg-gray-950 border border-t-0 border-gray-800 rounded-b-xl flex items-center p-2">
        <span className="text-green-500 ml-2 mr-3 font-bold">root@cybersec:~$</span>
        <input 
          type="text" 
          value={input}
          onChange={(e) => setInput(e.target.value)}
          className="flex-1 bg-transparent text-gray-200 outline-none w-full"
          autoFocus
          autoComplete="off"
          spellCheck="false"
        />
      </form>
    </div>
  );
}

